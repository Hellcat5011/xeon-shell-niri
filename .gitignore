# User-specific runtime data and caches
data/current-wallpaper.txt
scripts/.cache/

# Rust build artifacts (keep the pre-compiled helper binary)
/target/
helpers/gamma-ctl/target/*
!helpers/gamma-ctl/target/release/
helpers/gamma-ctl/target/release/*
!helpers/gamma-ctl/target/release/gamma-ctl
**/*.rs.bk

# Python cache & compiled files
