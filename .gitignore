*.py[cod]
*$py.class
.pytest_cache/

# Backup, temporary, and editor files
*.bak
*.tmp
*.orig
*.rej
*~
*.swp
*.swo
.DS_Store
.directory
.vscode/
.idea/

# Reports, testing logs, and agent artifacts
reports/
scratch/
evidence/
evidence.log
*.log
AGENTS.md
changes/
plans/

# Process & socket files
*.pid
*.sock
